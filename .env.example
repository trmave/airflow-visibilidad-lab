# Copiar a .env (640) y rellenar. NUNCA versionar el .env real.
# Los valores se generan con:
#   openssl rand -hex 24      (contraseñas)
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"  (fernet)

PG_AIRFLOW_PASSWORD=          # contraseña del usuario 'airflow' en Postgres
AIRFLOW_ADMIN_PASSWORD=       # contraseña del admin de la UI de Airflow
AIRFLOW_FERNET_KEY=           # clave fernet de Airflow (32 bytes en base64 urlsafe)
GRAFANA_ADMIN_PASSWORD=       # admin de Grafana
GRAFANA_RO_PASSWORD=          # contraseña del rol grafana_ro (solo lectura)
RENDERER_TOKEN=               # token compartido entre Grafana y grafana-image-renderer
