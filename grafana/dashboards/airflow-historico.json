      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-airflow"
          },
          "query": "from(bucket: \"airflow\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"airflow_kpi\" and r._field == \"dags_active\")\n  |> last()",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
