    {
      "id": 8,
      "type": "table",
      "title": "Corriendo más de 1 hora · detalle",
      "description": "Quién se está pasando del umbral, con minutos transcurridos.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airflow-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airflow-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH det AS (\nSELECT dag_id,\n   run_id,\n   start_date,\n   round(extract(epoch FROM (now() - start_date)) / 60)::int AS minutos\nFROM dag_run\nWHERE state = 'running'\nAND start_date < now() - interval '1 hour'\nORDER BY start_date\nLIMIT 50\n)\n-- Fila de cortesía: si no hay DAGs lentos, el panel dice que todo está bien\n-- en vez de mostrar \"No data\", que parece un tablero roto.\nSELECT det.* FROM det\nUNION ALL\nSELECT '— ninguno —'::text,\n'no hay DAGs por encima de 1 hora'::text,\nNULL::timestamptz,\nNULL::int\nWHERE NOT EXISTS (SELECT 1 FROM det)"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
