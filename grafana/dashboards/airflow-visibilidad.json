    {
      "id": 10,
      "type": "table",
      "title": "Último estado de cada DAG",
      "description": "El estado del run más reciente por DAG: la vista que se mira a diario.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airflow-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
