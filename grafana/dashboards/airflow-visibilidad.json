          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH det AS (\nSELECT dag_id,\n   run_id,\n   queued_at,\n   round(extract(epoch FROM (now() - queued_at)) / 60)::int AS minutos_esperando\nFROM dag_run\nWHERE state = 'queued'\nAND queued_at < now() - interval '15 minutes'\nORDER BY queued_at\nLIMIT 50\n)\nSELECT det.* FROM det\nUNION ALL\nSELECT '— ninguno —'::text,\n'nada lleva más de 15 min en cola'::text,\nNULL::timestamptz,\nNULL::int\nWHERE NOT EXISTS (SELECT 1 FROM det)"
        }
