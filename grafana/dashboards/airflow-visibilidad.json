      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airflow-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH ultimo AS (\n    SELECT dag_id,\n           state,\n           execution_date,\n           row_number() OVER (PARTITION BY dag_id ORDER BY execution_date DESC) AS rn\n    FROM dag_run\n)\nSELECT dag_id, state AS ultimo_estado, execution_date AS ultima_ejecucion\nFROM ultimo\nWHERE rn = 1\nORDER BY state, dag_id"
        }
      ],
      "options": {
