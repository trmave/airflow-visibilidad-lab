    {
      "id": 1,
      "type": "stat",
      "title": "DAGs activos",
      "description": "DAGs activos en el DagBag (is_active) sin subdags, y cuántos están pausados.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airflow-pg"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airflow-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS dags_activos,\n       count(*) FILTER (WHERE is_paused) AS pausados\nFROM dag\nWHERE is_active AND NOT is_subdag"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
